# ── FastFund — environment template ───────────────────────────────────────────
# Copy to .env and fill in. .env is gitignored.

# LLM: xAI Grok (OpenAI-compatible API). Change summaries + the "ask the law"
# graph-RAG agent. Without XAI_API_KEY the app still runs; AI synthesis degrades
# to listing retrieved sources.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
LLM_PROVIDER=xai
GROK_MODEL=grok-4-1-fast-reasoning

# ── Storage backend ─────────────────────────────────────────────────────────
# 'neo4j'  — graph backend, powers graph-RAG retrieval (default).
# 'sqlite' — relational backend (also Postgres via DB_URL).
DATA_STORAGE=neo4j

# SQLite / Postgres connection (DATA_STORAGE=sqlite, and migration source).
DB_URL=sqlite:///fastfund.db

# Neo4j connection (DATA_STORAGE=neo4j).
#   Local dev:  bring up with scripts/neo4j_local.sh setup && scripts/neo4j_local.sh start
#   AuraDB:     NEO4J_URI=neo4j+s://<id>.databases.neo4j.io  (no other change)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# Default admin login (override in production).
ADMIN_EMAIL=admin@fastfund.org
ADMIN_PASSWORD=change-me

APP_SECRET=change-me
FASTFUND_PUBLIC=0
FASTFUND_AUTOSEED=0
FASTFUND_SEED_COUNT=100

# Google OAuth (optional).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://fund.fastsme.com/auth/callback
GOOGLE_ALLOWED_DOMAINS=

# Microsoft Azure AI Foundry (optional alternative to xAI).
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
FOUNDRY_MODEL=

# Family-office document storage: local filesystem or S3-compatible R2.
DOC_STORAGE=local
DOC_LOCAL_DIR=./data/documents
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
