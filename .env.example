# ── SFO Hub / JTC Group — environment template ──────────────────────────────
# Copy to .env and fill in. .env is gitignored.

# LLM: OpenAI-compatible chat endpoint. The conversational advisor + the AI half
# of the cross-sell scorer. Without a key the app still runs: chat degrades to a
# rules-only advisor and AI scoring is skipped.
#   dev:        LLM_PROVIDER=xai  + xAI Grok
#   production: LLM_PROVIDER=azure + Azure AI Foundry
LLM_PROVIDER=xai
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4-1-fast-reasoning

# Azure AI Foundry (production) — set LLM_PROVIDER=azure to use these.
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
FOUNDRY_MODEL=

# ── Storage backend ─────────────────────────────────────────────────────────
# 'neo4j'  — graph backend (default; production target is Neo4j AuraDB).
# 'sqlite' — relational backend (also Postgres via DB_URL); zero-infra for demos.
# For a one-command local demo, set DATA_STORAGE=sqlite.
DATA_STORAGE=sqlite

# SQLite / Postgres connection (DATA_STORAGE=sqlite).
DB_URL=sqlite:///sfohub.db

# Neo4j connection (DATA_STORAGE=neo4j).
#   Local dev:  scripts/neo4j_local.sh setup && scripts/neo4j_local.sh start
#   AuraDB:     NEO4J_URI=neo4j+s://<id>.databases.neo4j.io  (no other change)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# Default admin login (override in production).
ADMIN_EMAIL=admin@jtcgroup.com
ADMIN_PASSWORD=change-me

# Set to 1 to disable login for a public/demo deployment.
SFOHUB_PUBLIC=0

APP_SECRET=change-me
PORT=5021

# ── Document storage ────────────────────────────────────────────────────────
# 'local' — files on a persistent volume (DOC_LOCAL_DIR). Zero-infra.
# 'r2'    — Cloudflare R2 (S3-compatible); set the R2_* vars below.
DOC_STORAGE=local
DOC_LOCAL_DIR=data/uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sfohub-docs

# ── Google OAuth (OIDC) sign-in ─────────────────────────────────────────────
# Set both to enable the "Continue with Google" button. Optional
# GOOGLE_ALLOWED_DOMAINS (comma-separated) restricts sign-up to those domains.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAINS=
