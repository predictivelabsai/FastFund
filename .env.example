# ── TaxHub / JTCgroup — environment template ────────────────────────────────
# Copy to .env and fill in. .env is gitignored.

# LLM: xAI Grok (OpenAI-compatible API). Change summaries + the "ask the law"
# graph-RAG agent. Without XAI_API_KEY the app still runs; AI synthesis degrades
# to listing retrieved sources.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
LLM_PROVIDER=xai
GROK_MODEL=grok-4-1-fast-reasoning

# ── Storage backend ─────────────────────────────────────────────────────────
# 'neo4j'  — graph backend, powers graph-RAG retrieval (default).
# 'sqlite' — relational backend (also Postgres via DB_URL).
DATA_STORAGE=neo4j

# SQLite / Postgres connection (DATA_STORAGE=sqlite, and migration source).
DB_URL=sqlite:///taxhub.db

# Neo4j connection (DATA_STORAGE=neo4j).
#   Local dev:  bring up with scripts/neo4j_local.sh setup && scripts/neo4j_local.sh start
#   AuraDB:     NEO4J_URI=neo4j+s://<id>.databases.neo4j.io  (no other change)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# Default admin login (override in production).
ADMIN_EMAIL=admin@jtgroup.com
ADMIN_PASSWORD=change-me

APP_SECRET=change-me
